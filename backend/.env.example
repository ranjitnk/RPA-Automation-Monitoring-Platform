APP_ENV=development
APP_DEBUG=true
APP_NAME=uipath-monitor-api
APP_VERSION=1.0.0
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:5173
APP_API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://monitor:monitor@localhost:5432/uipath_monitor
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_CACHE_TTL_SECONDS=300

JWT_SECRET_KEY=dev-only-change-in-production-min-32-chars!!
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

ES_ENABLED=false
ES_URL=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme
ES_INDEX_PREFIX=uipath-monitor

SCHEDULER_ENABLED=true
SCHEDULER_SYNC_INTERVAL_SECONDS=60
SCHEDULER_SLA_INTERVAL_SECONDS=120

CREDENTIALS_ENCRYPTION_KEY=
CELERY_ENABLED=false
