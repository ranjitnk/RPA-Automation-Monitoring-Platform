# ============================================================================
# UiPath Observability Platform - Environment Configuration
# ============================================================================
# This file contains all environment variables for the application.
# Copy this to .env for development or .env.prod for production.
#
# IMPORTANT: Never commit actual secrets to version control.
# Use strong, random values for all passwords in production.
#
# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database Host
# Default: postgres (Docker service name in development)
# Production: Use managed database service hostname
POSTGRES_HOST=postgres

# PostgreSQL Database Port
# Default: 5432
POSTGRES_PORT=5432

# PostgreSQL Database Name
# Default: observability_db
# Production: Use descriptive name (e.g., uipath_prod_db)
POSTGRES_DB=observability_db

# PostgreSQL Database User
# Default: postgres
# Production: Use non-default user with limited permissions
POSTGRES_USER=postgres

# PostgreSQL Database Password
# REQUIRED: Change in production to a strong, random value
# Minimum 16 characters with mixed case, numbers, and special characters
# Example: P@ssw0rd!2024#SecureDB
POSTGRES_PASSWORD=postgres

# PostgreSQL SSL Mode
# Options: disable, allow, prefer, require, verify-ca, verify-full
# Default: prefer (development)
# Production: require or verify-ca
POSTGRES_SSLMODE=prefer

# PostgreSQL Connection Pool Size
# Default: 20
# Adjust based on workload and server capacity
POSTGRES_POOL_SIZE=20

# PostgreSQL Connection Timeout (seconds)
# Default: 30
POSTGRES_TIMEOUT=30

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis Host
# Default: redis (Docker service name)
# Production: Use managed Redis service or cluster endpoint
REDIS_HOST=redis

# Redis Port
# Default: 6379
REDIS_PORT=6379

# Redis Password
# REQUIRED: Change in production to a strong, random value
# Must match the password set in redis.conf
REDIS_PASSWORD=redis_password

# Redis Database Number (0-15)
# Default: 0
# Use separate databases for cache and sessions
REDIS_DB=0

# Redis TTL for Cache Entries (seconds)
# Default: 3600 (1 hour)
# Adjust based on data freshness requirements
REDIS_TTL=3600

# Redis Connection Pool Size
# Default: 10
REDIS_POOL_SIZE=10

# ============================================================================
# ELASTICSEARCH CONFIGURATION
# ============================================================================

# Elasticsearch Host
# Default: elasticsearch (Docker service name)
# Production: Use managed Elasticsearch or cluster endpoint
ELASTICSEARCH_HOST=http://elasticsearch:9200

# Elasticsearch Security Enabled
# Options: true, false
# Default: false (development)
# Production: true
ELASTIC_SECURITY_ENABLED=false

# Elasticsearch Username
# Default: elastic (only used if security is enabled)
ELASTIC_USER=elastic

# Elasticsearch Password
# REQUIRED if ELASTIC_SECURITY_ENABLED=true
# Change in production to a strong, random value
ELASTIC_PASSWORD=changeme

# Elasticsearch JVM Heap Size
# Default: -Xms512m -Xmx512m (512MB)
# Production: Set to 50% of available RAM, maximum 30GB
# Example: -Xms2g -Xmx2g (2GB)
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Elasticsearch Index Prefix for Logs
# Default: uipath-observability
# Allows multiple applications to share one cluster
ELASTICSEARCH_INDEX_PREFIX=uipath-observability

# Elasticsearch Index Rotation
# Options: daily, weekly, monthly
# Default: daily
ELASTICSEARCH_INDEX_ROTATION=daily

# Elasticsearch Retention Days
# Default: 30
# Production: 90-365 depending on compliance requirements
ELASTICSEARCH_RETENTION_DAYS=30

# ============================================================================
# KIBANA CONFIGURATION
# ============================================================================

# Kibana Host
# Default: kibana (Docker service name)
# Used for health checks and logging dashboard access
KIBANA_HOST=kibana

# Kibana Port
# Default: 5601
KIBANA_PORT=5601

# Kibana Encryption Key (32 characters minimum)
# Generate: openssl rand -base64 32
# REQUIRED for production
KIBANA_ENCRYPTION_KEY=your-32-char-encryption-key-here

# Kibana Username (xpack.security)
# Default: kibana_system
KIBANA_USER=kibana_system

# Kibana Password
# REQUIRED if Elasticsearch security is enabled
# Change in production to a strong, random value
KIBANA_PASSWORD=changeme

# ============================================================================
# FASTAPI BACKEND CONFIGURATION
# ============================================================================

# Backend Host
# Default: 0.0.0.0 (listen on all interfaces)
# Production: 127.0.0.1 (only Nginx should connect)
BACKEND_HOST=0.0.0.0

# Backend Port
# Default: 8000
BACKEND_PORT=8000

# Backend Workers (Gunicorn/Uvicorn)
# Default: 4
# Recommended: (CPU cores * 2) + 1
# Example: 8-core server = 17 workers
WORKERS=4

# Backend Worker Timeout (seconds)
# Default: 120
WORKER_TIMEOUT=120

# Application Environment
# Options: development, staging, production
# Default: development
ENVIRONMENT=development

# Application Log Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO (production), DEBUG (development)
LOG_LEVEL=INFO

# ============================================================================
# JWT SECURITY CONFIGURATION
# ============================================================================

# JWT Secret Key (minimum 32 characters)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED: Change in production to a strong, random value
# CRITICAL: Never commit actual value to version control
JWT_SECRET=your-secret-key-change-in-production-12345

# JWT Algorithm
# Default: HS256
# Options: HS256, HS384, HS512, RS256, RS384, RS512
JWT_ALGORITHM=HS256

# JWT Token Expiration (hours)
# Default: 24
# Recommended: 1-24 hours depending on security requirements
JWT_EXPIRATION_HOURS=24

# JWT Refresh Token Expiration (days)
# Default: 7
JWT_REFRESH_EXPIRATION_DAYS=7

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed Origins (comma-separated)
# Specifies which domains can make requests to the API
# Default: http://localhost:5173,http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
# NOTE: Be restrictive in production to prevent CSRF attacks
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# CORS Allow Credentials
# Options: true, false
# Default: true
# Required for cookies and authentication headers
CORS_ALLOW_CREDENTIALS=true

# CORS Allow Methods (comma-separated)
# Default: GET,HEAD,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_METHODS=GET,HEAD,POST,PUT,DELETE,OPTIONS,PATCH

# CORS Allow Headers (comma-separated)
# Default: Content-Type,Authorization,X-Requested-With
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend Port
# Default: 5173 (Vite dev server) or 3000 (production)
FRONTEND_PORT=5173

# API Base URL (used by frontend)
# Development: http://localhost:8000/api/v1
# Production: https://yourdomain.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket URL (used by frontend for real-time updates)
# Development: ws://localhost:8000/ws
# Production: wss://yourdomain.com/ws
VITE_WS_URL=ws://localhost:8000/ws

# ============================================================================
# NGINX CONFIGURATION
# ============================================================================

# Nginx HTTP Port
# Default: 80
# Production: Usually 80 for traffic to be redirected to HTTPS
NGINX_HTTP_PORT=80

# Nginx HTTPS Port
# Default: 443
# Production: Must be 443 for HTTPS
NGINX_HTTPS_PORT=443

# Nginx SSL Certificate Path
# Default: /etc/nginx/ssl/cert.pem
# Production: Use valid signed certificate from CA
NGINX_SSL_CERT=/etc/nginx/ssl/cert.pem

# Nginx SSL Key Path
# Default: /etc/nginx/ssl/key.pem
NGINX_SSL_KEY=/etc/nginx/ssl/key.pem

# Nginx SSL Protocol
# Default: TLSv1.2 TLSv1.3
# Production: Enforce TLSv1.2 minimum (TLSv1.3 preferred)
NGINX_SSL_PROTOCOLS=TLSv1.2 TLSv1.3

# Nginx Cache Size
# Default: 100m
# Production: Adjust based on available disk space
# Larger cache improves performance for static assets
NGINX_CACHE_SIZE=100m

# Nginx Gzip Compression
# Options: on, off
# Default: on
# Reduces bandwidth by compressing responses
NGINX_GZIP=on

# Nginx Gzip Level (1-9)
# Default: 6
# Higher = better compression but higher CPU usage
NGINX_GZIP_LEVEL=6

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Application Log Format
# Options: json, text
# Default: json (recommended for aggregation)
LOG_FORMAT=json

# Application Log File
# Default: ./logs/app.log
# Production: Use centralized logging service
LOG_FILE=./logs/app.log

# Database Query Logging
# Options: true, false
# Default: false
# Enable to debug slow queries (production performance impact)
DATABASE_QUERY_LOGGING=false

# Database Query Logging Threshold (milliseconds)
# Log queries slower than this threshold
DATABASE_QUERY_LOGGING_THRESHOLD=1000

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Prometheus Metrics Enabled
# Options: true, false
# Default: false
PROMETHEUS_ENABLED=false

# Prometheus Metrics Port
# Default: 9090
PROMETHEUS_PORT=9090

# Health Check Interval (seconds)
# Default: 30
# How often services check each other's health
HEALTH_CHECK_INTERVAL=30

# Sentry Error Tracking (optional)
# Sentry DSN for error tracking
# Leave empty to disable
SENTRY_DSN=

# ============================================================================
# BACKUP & MAINTENANCE
# ============================================================================

# Database Backup Schedule (cron format)
# Default: 0 2 * * * (daily at 2 AM)
# Cron expressions: minute hour day month weekday
DB_BACKUP_SCHEDULE=0 2 * * *

# Database Backup Retention (days)
# Default: 30
# Older backups are automatically deleted
DB_BACKUP_RETENTION_DAYS=30

# Database Vacuum Schedule (cron format)
# Default: 0 3 * * 0 (weekly on Sunday at 3 AM)
DB_VACUUM_SCHEDULE=0 3 * * 0

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================

# UiPath Orchestrator API Configuration
# Base URL of the UiPath Orchestrator
UIPATH_ORCHESTRATOR_URL=https://orchestrator.example.com

# UiPath Orchestrator API Key
# Generate from UiPath Orchestrator settings
UIPATH_API_KEY=

# UiPath Tenant Name
# Default tenant if not specified in API calls
UIPATH_TENANT_NAME=

# UiPath Organization Unit
# Default organization unit
UIPATH_ORG_UNIT=

# ============================================================================
# SECURITY
# ============================================================================

# API Rate Limiting (requests per minute)
# Default: 100
# Prevents brute force and DoS attacks
RATE_LIMIT_PER_MINUTE=100

# IP Whitelist (comma-separated)
# Leave empty to allow all IPs
# Production: Restrict to known networks
IP_WHITELIST=

# API Key Required
# Options: true, false
# Default: false (use JWT instead)
# Set to true for service-to-service authentication
API_KEY_REQUIRED=false

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Debug Mode (development only)
# Options: true, false
# Default: false
# NEVER enable in production
DEBUG=false

# Seed Database with Test Data
# Options: true, false
# Default: false
# Populates database with sample data for testing
SEED_DATABASE=false

# Mock External Services
# Options: true, false
# Default: false
# Use mock responses instead of real API calls
MOCK_EXTERNAL_SERVICES=false

# ============================================================================
# DEPRECATED / LEGACY
# ============================================================================

# These variables are kept for backward compatibility.
# Prefer the variables above for new deployments.

# Legacy Database URL (if used)
# Overrides individual POSTGRES_* variables if set
# DATABASE_URL=

# Legacy Redis URL (if used)
# Overrides individual REDIS_* variables if set
# REDIS_URL=
