# Root — used by docker-compose variable substitution
COMPOSE_PROJECT_NAME=uipath-monitor

# PostgreSQL
POSTGRES_USER=monitor
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=uipath_monitor

# Redis
REDIS_PASSWORD=

# Elasticsearch
ES_JAVA_OPTS=-Xms512m -Xmx512m
ELASTIC_PASSWORD=change_me_in_production

# Backend (passed to backend service)
APP_ENV=development
APP_DEBUG=true
JWT_SECRET_KEY=generate-a-secure-random-key-min-32-chars

# URLs (docker network hostnames)
BACKEND_URL=http://backend:8000
FRONTEND_URL=http://localhost:5173
